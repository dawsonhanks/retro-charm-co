# ── Required for checkout (api/create-checkout.js) ──────────────────────────
# Square Developer Dashboard → Credentials / Locations
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Public https origin (no trailing slash). Used for checkout redirect + email images.
# Also read by api/square-webhook.js. Prefer production domain, never localhost.
VITE_SITE_URL=https://www.theretrocharmco.com

# ── Required for order fulfillment + webhook hardening (api/square-webhook.js) ──
# Square Developer Dashboard → Webhooks → signature key for this notification URL.
# Server-only. Never expose via a VITE_* variable or client code.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# The EXACT production notification URL registered for this subscription in
# the Square Developer Dashboard (must match byte-for-byte, incl. https:// and
# no trailing slash — Square signs HMAC over notificationUrl + rawBody).
# Server-only. Never expose via a VITE_* variable or client code.
SQUARE_WEBHOOK_NOTIFICATION_URL=https://www.theretrocharmco.com/api/square-webhook
# Where completed-order emails are sent
NOTIFICATION_EMAIL=
# Resend dashboard API key (sender: orders@theretrocharmco.com)
RESEND_API_KEY=
# Optional: seconds before an abandoned fulfillment-email processing claim
# becomes reclaimable by a retry — see docs/webhook.md "Fulfillment email:
# a lease, not a claim". Defaults to 120 if unset or invalid.
FULFILLMENT_LEASE_SECONDS=

# ── Required for webhook durability + website-order correlation ─────────────
# (api/_lib/webhookStore.js, also used by api/create-checkout.js and
# api/email-signup.js). Without these, the webhook cannot prove a completed
# payment came from theretrocharmco.com checkout or that it hasn't already
# been counted — see docs/webhook.md. Supabase → Project Settings → API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Tables/functions expected (see supabase/migrations/20260808*.sql):
#   public.checkout_sessions              — website-order correlation
#   public.webhook_events                 — webhook delivery audit log (event_id)
#   public.purchase_completions           — entire-purchase failure-recovery state (payment_id)
#   public.purchase_inventory_decrements  — per-item inventory ledger
#   public.email_signups                  — unique column `email`
#   claim_and_decrement_charm_stock()     — atomic inventory claim + decrement
#   claim_fulfillment_lease()             — atomic fulfillment-email lease claim

# ── Required for live charm inventory (fail-safe) ───────────────────────────
# Client reads public.inventory via Supabase REST (src/lib/inventory.js).
# Production NEVER fail-opens when these are missing — browsing stays up, but
# Add to Bracelet / bundle Add to Cart / checkout stay blocked until inventory
# can be verified. See docs/inventory.md.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local development only: mock all catalog items as in stock.
# Ignored unless the Vite app is running in DEV mode.
# VITE_INVENTORY_MODE=mock

# EMERGENCY ONLY — do not enable by default.
# When set to the literal string "true", checkout may skip stock blocking.
# Server (production emergency): INVENTORY_EMERGENCY_FAIL_OPEN=true
# Client DEV only: VITE_INVENTORY_EMERGENCY_FAIL_OPEN=true
# Missing / unset variables never enable fail-open.
# INVENTORY_EMERGENCY_FAIL_OPEN=

# ── Optional: conversion analytics advertising pixels (client) ──────────────
# Public pixel / tag IDs only. Leave blank to skip — the storefront never fails
# when these are absent. Custom funnel events always go through Vercel Analytics
# via src/lib/analytics.js (see docs/analytics.md).
VITE_META_PIXEL_ID=
VITE_GOOGLE_ADS_ID=
