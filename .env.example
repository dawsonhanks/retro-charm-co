# ── Required for checkout (api/create-checkout.js) ──────────────────────────
# Square Developer Dashboard → Credentials / Locations
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Public https origin (no trailing slash). Used for checkout redirect + email images.
# Also read by api/square-webhook.js. Prefer production domain, never localhost.
VITE_SITE_URL=https://www.theretrocharmco.com

# ── Required for order fulfillment email (api/square-webhook.js) ────────────
# Square Developer Dashboard → Webhooks → signature key for this notification URL
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Where completed-order emails are sent
NOTIFICATION_EMAIL=
# Resend dashboard API key (sender: orders@theretrocharmco.com)
RESEND_API_KEY=

# ── Optional: email signup storage (api/email-signup.js) ────────────────────
# Without these, the signup form still shows success but nothing is stored.
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Table expected: public.email_signups with unique column `email`

# ── Optional: live charm inventory (api/inventory.js) ───────────────────────
# Published Google Sheet CSV export URL (File → Share → Publish to web → CSV).
# Columns: Charm Name, Metal (Silver/Gold), Count, In Stock (YES/NO)
# If unset or unreachable, every charm shows as in stock (fail open).
INVENTORY_CSV_URL=
